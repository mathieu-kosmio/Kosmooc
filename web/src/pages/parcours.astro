---
import Base from '../layouts/Base.astro';
import Rondelle from '../components/Rondelle.astro';
import { getCollection } from 'astro:content';
import { assembler, fmtDuree } from '../lib/parcours.js';
const parcours = assembler(await getCollection('modules'));
const vue = parcours.map((p) => ({
  id: p.id, titre: p.titre, badge: p.badge, intitule: p.badgeDef?.intitule,
  requis: p.badgeDef?.requis || null,
  modules: p.modules.map((m) => ({ id: m.id, label: m.label, titre: m.titre, quiz: m.quiz, communs: m.communs })),
}));
---
<Base title="Mon parcours" current="parcours">
  <header class="page-head">
    <div class="container">
      <span class="eyebrow" id="hello">Mon parcours</span>
      <h1>Académie PerfIA, <em>vos parcours.</em></h1>
      <div class="tabs" role="tablist" aria-label="Choisir un parcours">
        {parcours.map((p) => (
          <button type="button" role="tab" class="tab" data-tab={p.id} aria-selected="false" aria-controls={`panel-${p.id}`}>
            <strong>{p.titre}</strong>
            <span>{p.sous_titre}</span>
            <span class="tab__meta">{p.nbModules} modules · {fmtDuree(p.duree)} · <b data-tab-pct={p.id}>0 %</b></span>
          </button>
        ))}
      </div>
    </div>
  </header>
  <section class="container" style="padding-block: var(--space-7) var(--space-9)">
    {parcours.map((p) => (
      <div class="panel" id={`panel-${p.id}`} role="tabpanel" data-panel={p.id} hidden>
        <div class="dash">
          <div class="dash__ring">
            <Rondelle modules={p.modules.map((m) => ({ id: m.id, label: m.label, titre: m.titre, etape: m.etape }))} size="panel" parcours={p.id} />
          </div>
          <div class="dash__side">
            <div data-next></div>
            {p.id === 'mettre-en-place' && (
              <div class="card seance-card" data-seance hidden>
                <span class="t-micro">Inclus dans votre parcours formation ou accompagnement</span>
                <h2 class="t-h3">Votre séance individuelle en visio</h2>
                <p>Choisissez un créneau avec Mathieu Pesin, votre formateur, pour travailler sur votre cas. Le meilleur moment : après le module 5, quand votre projet est monté. La séance est incluse pour les personnes inscrites à la formation en atelier ou à l'accompagnement PerfIA.</p>
                <a class="btn btn--primary" href="https://cal.com/kosmio/perfia-academie" target="_blank" rel="noopener">Réserver ma séance ↗</a>
              </div>
            )}
            {p.id === 'bases' && (
              <div class="card card--sand">
                <span class="t-micro">Attestation Open Badges</span>
                <h2 class="t-h3" style="margin:var(--space-3) 0">Maîtrise de l'IA, article 4 de l'AI Act</h2>
                <p class="t-small" style="margin:0">Elle est émise automatiquement quand les quiz des modules 1 à 4 sont réussis. Datée et vérifiable en ligne, elle se télécharge au format Open Badges et votre employeur peut la conserver comme trace de formation.</p>
              </div>
            )}
          </div>
        </div>

        <div class="grid grid--3" style="margin-bottom: var(--space-6)">
          <div class="card"><div class="stat" data-pct>0 %</div><div class="stat-label">du parcours terminé</div><div class="progress" style="margin-top:var(--space-3)"><span data-bar></span></div></div>
          <div class="card"><div class="stat" data-quiz>0</div><div class="stat-label">quiz réussis sur {p.modules.filter((m) => m.quiz).length}</div></div>
          <div class="card"><div class="stat" data-badge-stat>À venir</div><div class="stat-label" data-badge-label>{p.id === 'bases' ? 'Attestation Les bases de l\'IA' : 'Badge Niveau 1'}</div></div>
        </div>

        <h2 class="t-h3">Modules</h2>
        <p class="t-small" data-acquis hidden>Les modules communs déjà terminés dans l'autre parcours sont acquis : vous ne les refaites pas.</p>
        <ol class="modules">
          {p.modules.map((m) => (
            <li>
              <a class="module-row" href={`/modules/${m.id}/?p=${p.id}`} data-mid={m.id}>
                <span class="module-row__num">M{m.label}</span>
                <span><span class="module-row__title">{m.titre}</span><br /><span class="module-row__meta">{m.duree} min{m.quiz ? ' · quiz' : ''}{m.communs.length ? ' · commun aux deux parcours' : ''}</span></span>
                <span class="pill pill--todo" data-status>À faire</span>
              </a>
            </li>
          ))}
        </ol>

        {p.id === 'mettre-en-place' && (
          <>
            <h2 class="t-h3" style="margin-top: var(--space-7)">Projet final et retours</h2>
            <div data-projet class="card"><p class="t-small">Chargement…</p></div>
          </>
        )}
      </div>
    ))}
  </section>
  <script define:vars={{ vue }}>
    window.__PARCOURS__ = vue;
  </script>
  <script>
    import { pb, requireLogin, user, esc, fmtDate } from '../lib/pb.js';
    import { parcoursChoisi, memoriserParcours } from '../lib/parcours.js';
    if (requireLogin()) load();

    function ouvrir(id: string) {
      document.querySelectorAll<HTMLElement>('[data-panel]').forEach((el) => { el.hidden = el.dataset.panel !== id; });
      document.querySelectorAll<HTMLElement>('[data-tab]').forEach((el) => el.setAttribute('aria-selected', String(el.dataset.tab === id)));
      memoriserParcours(id);
      const url = new URL(location.href); url.searchParams.set('p', id); history.replaceState(null, '', url);
    }
    document.querySelectorAll<HTMLElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => ouvrir(b.dataset.tab!)));

    async function load() {
      const u = user();
      const vue = (window as any).__PARCOURS__ as any[];
      document.getElementById('hello')!.textContent = `Bonjour ${u.name || u.email}`;
      const f = pb.filter('user = {:u}', { u: u.id });
      const [progress, attempts, subs, badges] = await Promise.all([
        pb.collection('progress').getFullList({ filter: f }),
        pb.collection('quiz_attempts').getFullList({ filter: f + ' && reussi = true' }),
        pb.collection('submissions').getFullList({ filter: f + ' && type = "projet_final"', sort: '-created' }),
        pb.collection('badges').getFullList({ filter: f }),
      ]);
      const st: Record<string, string> = Object.fromEntries(progress.map((p: any) => [p.module, p.statut]));
      const passed = new Set(attempts.map((a: any) => a.module));

      // Parcours affiché : choix explicite, sinon celui où l'apprenant a avancé, sinon le premier.
      const propres = (p: any) => p.modules.filter((m: any) => !m.communs.length).some((m: any) => st[m.id]);
      const choisi = parcoursChoisi(vue.map((p) => p.id)) || (vue.find(propres) || vue[0]).id;
      ouvrir(choisi);

      for (const p of vue) {
        const panel = document.querySelector<HTMLElement>(`[data-panel="${p.id}"]`)!;
        const q = (s: string) => panel.querySelector<HTMLElement>(s)!;
        let done = 0, acquis = false;
        panel.querySelectorAll<HTMLElement>('[data-mid]').forEach((row) => {
          const s = st[row.dataset.mid!];
          const m = p.modules.find((x: any) => x.id === row.dataset.mid);
          const pill = row.querySelector('[data-status]')!;
          if (s === 'termine') { done++; pill.className = 'pill pill--ok'; pill.textContent = m.communs.length ? 'Terminé, acquis' : 'Terminé'; if (m.communs.length) acquis = true; }
          else if (s === 'en_cours') { pill.className = 'pill pill--wip'; pill.textContent = 'En cours'; }
        });
        q('[data-acquis]').hidden = !acquis;
        const pct = Math.round((done / p.modules.length) * 100);
        q('[data-pct]').textContent = `${pct} %`;
        q('[data-bar]').style.width = `${pct}%`;
        document.querySelector<HTMLElement>(`[data-tab-pct="${p.id}"]`)!.textContent = `${pct} %`;
        q('[data-quiz]').textContent = String(p.modules.filter((m: any) => m.quiz && passed.has(m.id)).length);

        const next = p.modules.find((m: any) => st[m.id] !== 'termine');
        const b = badges.find((x: any) => x.code === p.badge);
        q('[data-next]').innerHTML = next
          ? `<a class="btn btn--primary" href="/modules/${next.id}/?p=${p.id}">${st[next.id] ? 'Reprendre' : 'Commencer'} : M${esc(next.label)} ${esc(next.titre)}</a>`
          : p.id === 'mettre-en-place'
            ? '<a class="btn btn--primary" href="/projet-final/">Tous les modules sont terminés : déposer mon projet final</a>'
            : b ? `<a class="btn btn--primary" href="/badge/?id=${esc(b.id)}">Parcours terminé : voir mon attestation</a>` : '<p class="t-small">Parcours terminé. Votre attestation est en cours d\'émission : rechargez la page.</p>';

        if (b) {
          q('[data-badge-stat]').textContent = 'Obtenu';
          q('[data-badge-label]').innerHTML = `${esc(b.intitule)}<br /><a href="/badge/?id=${esc(b.id)}">Voir, télécharger et partager</a>`;
        }
        const seance = panel.querySelector<HTMLElement>('[data-seance]');
        if (seance) seance.hidden = st['m5'] !== 'termine';

        const box = panel.querySelector<HTMLElement>('[data-projet]');
        if (!box) continue;
        if (!subs.length) {
          box.innerHTML = `<p>Vous n'avez pas encore déposé votre projet final. Il se prépare au fil des modules et se dépose après le module 9.</p><a class="btn btn--secondary btn--sm" href="/projet-final/">Préparer mon projet final</a>`;
          continue;
        }
        const evals = await pb.collection('evaluations').getFullList({ filter: pb.filter('submission.user = {:u}', { u: u.id }), sort: '-created' });
        const label: any = { depose: 'Déposé, en attente d\'évaluation', en_evaluation: 'En cours d\'évaluation', valide: 'Validé', a_reprendre: 'À reprendre' };
        box.innerHTML = subs.map((s: any) => {
          const ev = evals.find((e: any) => e.submission === s.id);
          return `<div style="margin-bottom:var(--space-4)"><strong>Dépôt du ${fmtDate(s.created)}</strong> · <span class="pill ${s.statut === 'valide' ? 'pill--ok' : s.statut === 'a_reprendre' ? 'pill--wip' : ''}">${label[s.statut] || s.statut}</span>
            ${ev?.commentaire ? `<div class="explication" style="margin-top:var(--space-2);background:var(--km-sage-50);padding:var(--space-3);border-radius:4px"><strong>Retour de l'évaluateur :</strong> ${esc(ev.commentaire)}</div>` : ''}</div>`;
        }).join('') + (subs[0].statut === 'a_reprendre' ? '<a class="btn btn--secondary btn--sm" href="/projet-final/">Déposer une nouvelle version</a>' : '');
      }
    }
  </script>
</Base>

<style>
  .tabs { display: grid; gap: var(--space-3); margin-top: var(--space-6); }
  @media (min-width: 760px) { .tabs { grid-template-columns: 1fr 1fr; } }
  .tab { text-align: left; display: grid; gap: 4px; padding: var(--space-4) var(--space-5); border-radius: var(--radius-lg); border: 1px solid var(--grey-300); background: var(--white); color: var(--ink-900); font: inherit; cursor: pointer; transition: border-color .2s var(--ease-out), background .2s var(--ease-out); }
  .tab strong { font-size: 1.1rem; }
  .tab span { font-size: .9rem; color: var(--ink-700); }
  .tab .tab__meta { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; color: var(--grey-600); }
  .tab:hover { border-color: var(--xf-green-500); }
  .tab[aria-selected="true"] { border-color: var(--xf-green-500); background: var(--xf-green-50); box-shadow: inset 0 0 0 1px var(--xf-green-500); }
  .tab:focus-visible { outline: 2px solid var(--xf-green-500); outline-offset: 2px; }
  .dash { display: grid; gap: var(--space-5); margin-bottom: var(--space-5); }
  @media (min-width: 900px) { .dash { grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); } }
  .dash__ring { background: radial-gradient(500px 300px at 90% 0%, rgba(0,177,148,.18), transparent 60%), var(--ink-900); border-radius: var(--radius-lg); padding: var(--space-6) var(--space-5); display: grid; place-items: center; }
  .dash__side { display: grid; gap: var(--space-5); align-content: start; min-width: 0; }
  .dash__side [data-next]:empty { display: none; }
  .dash__side [data-next] :global(.btn) { width: 100%; justify-content: center; height: auto; min-height: 56px; padding-block: var(--space-3); text-align: center; }
  .seance-card { background: var(--xf-green-50); border-color: rgba(0,153,130,.3); }
  .seance-card h2 { margin: var(--space-3) 0; }
  .seance-card p { color: var(--ink-700); }
</style>

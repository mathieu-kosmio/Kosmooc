---
import Base from '../layouts/Base.astro';
import Seal from '../components/Seal.astro';
import { BADGES } from '../lib/parcours.js';
---
<Base title="Vérification de badge">
  <div class="container">
    <div class="badge-cert" id="cert">
      {Object.entries(BADGES).map(([code, d]) => <div data-seal={code} hidden><Seal label={d.sceau} /></div>)}
      <p class="t-small" id="loading">Vérification en cours…</p>
      <div id="ok" hidden>
        <span class="eyebrow" id="eyebrow">Badge vérifié</span>
        <h1 id="intitule" style="margin-top:var(--space-3)"></h1>
        <p class="t-lead">délivré à <strong id="titulaire"></strong><span id="entreprise"></span></p>
        <p id="dates" class="t-small"></p>
        <p class="t-small" id="description"></p>
        <ul class="t-small badge-comp" id="competences"></ul>
        <p class="t-small">Émis par Kosmio dans le cadre de PerfIA, en partenariat avec Xylofutur. Format Open Badges 2.0, vérification hébergée.</p>
        <div class="no-print" style="display:flex;gap:var(--space-3);justify-content:center;flex-wrap:wrap;margin-top:var(--space-5)">
          <a class="btn btn--primary btn--sm" id="ob-image" download>Télécharger l'Open Badge</a>
          <button class="btn btn--secondary btn--sm" type="button" id="copy">Copier le lien de vérification</button>
          <a class="btn btn--secondary btn--sm" id="linkedin" target="_blank" rel="noopener">Ajouter à mon profil LinkedIn</a>
          <button class="btn btn--ghost btn--sm" type="button" onclick="window.print()">Télécharger l'attestation en PDF</button>
        </div>
        <p class="t-small no-print" style="margin-top:var(--space-4)">Le fichier Open Badge contient la preuve de vérification : importez-le dans votre portefeuille de badges ou transmettez-le à votre employeur. <a id="ob-json" target="_blank" rel="noopener">Données Open Badges (JSON)</a></p>
      </div>
      <div id="ko" hidden class="alert alert--error">Badge introuvable. Vérifiez le lien reçu.</div>
    </div>
  </div>
  <script define:vars={{ badges: BADGES }}>
    window.__BADGES__ = badges;
  </script>
  <script>
    import { pb, esc, fmtDate } from '../lib/pb.js';
    const defs = (window as any).__BADGES__;
    const id = new URLSearchParams(location.search).get('id');
    const $ = (x: string) => document.getElementById(x)!;
    (async () => {
      try {
        if (!id) throw new Error();
        const b = await pb.collection('badges').getOne(id);
        const d = defs[b.code] || {};
        const seal = document.querySelector<HTMLElement>(`[data-seal="${b.code}"]`) || document.querySelector<HTMLElement>('[data-seal]');
        if (seal) seal.hidden = false;
        $('eyebrow').textContent = b.code === 'perfia-bases' ? 'Attestation vérifiée' : 'Badge vérifié';
        $('intitule').textContent = b.intitule;
        $('titulaire').textContent = b.titulaire;
        $('entreprise').textContent = b.entreprise ? `, ${b.entreprise}` : '';
        const expired = b.expire_le && new Date(b.expire_le.replace(' ', 'T')) < new Date();
        $('dates').innerHTML = `Émis le ${fmtDate(b.emis_le)} · valable jusqu'au ${fmtDate(b.expire_le)}${expired ? ' <span class="pill pill--wip">expiré</span>' : ''}`;
        $('description').textContent = d.description || '';
        $('competences').innerHTML = (d.competences || []).map((c: string) => `<li>${esc(c)}</li>`).join('');
        const url = location.href;
        const api = `${location.origin}/api/academie/ob/assertions/${encodeURIComponent(b.id)}`;
        ($('ob-image') as HTMLAnchorElement).href = `${api}/image?download=1`;
        ($('ob-json') as HTMLAnchorElement).href = api;
        $('copy').addEventListener('click', async () => { try { await navigator.clipboard.writeText(url); $('copy').textContent = 'Lien copié'; } catch (_) {} });
        const dt = new Date(b.emis_le.replace(' ', 'T'));
        ($('linkedin') as HTMLAnchorElement).href = `https://www.linkedin.com/profile/add?startTask=CERTIFICATION_NAME&name=${encodeURIComponent(b.intitule)}&organizationName=${encodeURIComponent('Kosmio')}&issueYear=${dt.getFullYear()}&issueMonth=${dt.getMonth() + 1}&certUrl=${encodeURIComponent(url)}&certId=${encodeURIComponent(b.id)}`;
        $('ok').hidden = false;
      } catch (_) { $('ko').hidden = false; }
      $('loading').hidden = true;
    })();
  </script>
</Base>

<style>
  .badge-comp { text-align: left; max-width: 52ch; margin: 0 auto var(--space-4); }
</style>

---
import Base from '../layouts/Base.astro';
---
<Base title="Projet final" current="projet">
  <section class="container container--prose" style="padding-block: var(--space-7)">
    <span class="eyebrow">Badge Niveau 1</span>
    <h1 class="t-h2" style="margin-top:var(--space-3)">Déposer mon projet final</h1>
    <p class="t-lead">Votre projet final rassemble ce que vous avez produit sur votre cas fil rouge. Il est évalué sur les six compétences du badge.</p>
    <div class="card card--sand" style="margin-block: var(--space-5)">
      <h2 class="t-h3">Ce que le dossier doit contenir</h2>
      <ol>
        <li>La fiche E-T-S-C de votre cas d'usage (module 4)</li>
        <li>Votre prompt métier et le tableau de test sur un document inédit (modules 5 et 6)</li>
        <li>La grille de sobriété appliquée à vos tâches (module 3)</li>
        <li>La charte IA en 5 règles de votre entreprise (module 7)</li>
        <li>L'autodiagnostic de dépendance (module 8)</li>
        <li>La mesure avant et après, et votre décision pour la suite (module 9)</li>
      </ol>
      <p class="t-small"><a href="/ressources/modele-projet-final.md" download>Télécharger le modèle de projet final</a>. Le badge demande aussi le quiz du module 1 réussi (compétence C1).</p>
    </div>
    <div id="state"></div>
    <form class="form form--wide" id="form" hidden>
      <div class="field"><label for="files">Fichiers du projet (PDF, Word, tableur, texte ; 20 Mo maximum par fichier)</label><input id="files" type="file" multiple required /></div>
      <div class="field"><label for="lien">Lien complémentaire (optionnel)</label><input id="lien" type="url" placeholder="https://" /><small>Par exemple un projet partagé ou un dossier en ligne.</small></div>
      <div class="field"><label for="comment">Message à l'évaluateur</label><textarea id="comment" placeholder="Votre cas, ce qui a marché, ce qui reste à améliorer."></textarea></div>
      <label class="check"><input type="checkbox" id="anon" /> <span>Je confirme avoir retiré les données personnelles et confidentielles de mes documents.</span></label>
      <div id="msg" role="status"></div>
      <button class="btn btn--primary" type="submit">Déposer mon projet final</button>
    </form>
  </section>
  <script>
    import { pb, requireLogin, user, esc, errMsg, fmtDate } from '../lib/pb.js';
    const $ = (id: string) => document.getElementById(id)!;
    if (requireLogin()) init();
    async function init() {
      const u = user();
      const subs = await pb.collection('submissions').getFullList({ filter: pb.filter('user = {:u} && type = "projet_final"', { u: u.id }), sort: '-created' });
      const last = subs[0];
      if (last && ['depose', 'en_evaluation'].includes(last.statut)) {
        $('state').innerHTML = `<div class="alert alert--info">Projet déposé le ${fmtDate(last.created)}, en attente d'évaluation. Vous serez prévenu par email.</div>`;
        return;
      }
      if (last && last.statut === 'valide') {
        $('state').innerHTML = `<div class="alert alert--ok">Votre projet final est validé. <a href="/parcours/">Voir mon badge</a></div>`;
        return;
      }
      if (last && last.statut === 'a_reprendre') $('state').innerHTML = '<div class="alert alert--info">Votre précédent dépôt est à reprendre : consultez le retour dans « Mon parcours », puis déposez une nouvelle version.</div>';
      $('form').hidden = false;
    }
    $('form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const files = ($('files') as HTMLInputElement).files;
      if (!files || !files.length) { $('msg').innerHTML = '<div class="alert alert--error">Ajoutez au moins un fichier.</div>'; return; }
      if (!($('anon') as HTMLInputElement).checked) { $('msg').innerHTML = '<div class="alert alert--error">Merci de confirmer l\'anonymisation de vos documents.</div>'; return; }
      const fd = new FormData();
      fd.append('user', user().id); fd.append('module', 'm9'); fd.append('type', 'projet_final');
      [...files].forEach((f) => fd.append('fichiers', f));
      const lien = ($('lien') as HTMLInputElement).value.trim(); if (lien) fd.append('lien', lien);
      fd.append('commentaire', ($('comment') as HTMLTextAreaElement).value);
      try {
        await pb.collection('submissions').create(fd);
        $('form').hidden = true;
        $('state').innerHTML = '<div class="alert alert--ok">Projet final déposé. Un évaluateur vous répondra sous quelques jours.</div>';
      } catch (err) { $('msg').innerHTML = `<div class="alert alert--error">${esc(errMsg(err))}</div>`; }
    });
  </script>
</Base>

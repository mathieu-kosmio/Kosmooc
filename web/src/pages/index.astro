---
import Base from '../layouts/Base.astro';
import Seal from '../components/Seal.astro';
import Rondelle from '../components/Rondelle.astro';
import { getCollection } from 'astro:content';

const modules = (await getCollection('modules')).sort((a, b) => a.data.ordre - b.data.ordre).map((m) => m.data);
const total = modules.reduce((s, m) => s + m.duree, 0);
const heures = Math.floor(total / 60), minutes = total % 60;
const dureeTotale = minutes > 0 ? `${heures} h ${String(minutes).padStart(2, '0')}` : `${heures} h`;
const dMin = Math.min(...modules.map((m) => m.duree));
const dMax = Math.max(...modules.map((m) => m.duree));
const fmtDuree = (d: number) => (d >= 60 ? `${Math.floor(d / 60)} h${d % 60 ? ' ' + String(d % 60).padStart(2, '0') : ''}` : `${d} min`);



const cas = [
  'Devis vers fiche de production', 'Lecture de DCE', 'Tri des mails par projet', 'Compte rendu de chantier',
  'Fiche réglementaire EUDR', 'Contrôle de liste de débit', 'Synthèse hebdomadaire ERP', 'Mode opératoire vers fiche procédure',
];

const phases = [
  { n: '01', titre: 'Choisir votre cas', mods: 'M0', txt: "Vous faites le point sur vos usages et vous choisissez la tâche réelle que vous allez faire avancer jusqu'au bout." },
  { n: '02', titre: 'Comprendre et demander', mods: 'M1 à M3', txt: "Ce que fait un modèle, comment formuler une demande qui tient, et comment repérer les tâches où l'IA n'apporte rien." },
  { n: '03', titre: 'Prototyper', mods: 'M4 à M6', txt: 'Votre cas devient une fiche E-T-S-C, puis un projet dans votre outil. Votre séance individuelle tombe à ce moment-là, avant de tester une procédure réutilisable sur un document inédit.' },
  { n: '04', titre: 'Fiabiliser et décider', mods: 'M7 à M9', txt: 'Contrôles, données, dépendances, mesure avant et après : vous décidez de la suite sur des faits.' },
];

const competences = [
  ['C1', "Expliquer le fonctionnement et les limites d'une IA générative", 'Quiz du module 1'],
  ['C2', 'Formuler une demande efficace', 'Demande C du module 2'],
  ['C3', "Décider si une tâche relève de l'IA", 'Grille de sobriété, module 3'],
  ['C4', "Formuler un cas d'usage", 'Fiche E-T-S-C, module 4'],
  ['C5', 'Construire et tester un prototype réutilisable', 'Prompt métier et tableau de test, modules 5 et 6'],
  ['C6', "Utiliser l'IA de façon responsable", 'Charte et autodiagnostic, modules 7 et 8'],
];

const metiers = [
  'Sylviculture et exploitation forestière', 'Scieries et première transformation', 'Menuiserie, charpente et emballage',
  "Construction bois et bureaux d'études", 'Négoce et distribution', 'Ameublement et agencement',
];

const CAL = 'https://cal.com/kosmio/perfia-academie';

const faq = [
  ['Faut-il des compétences techniques ?', "Aucune. Le parcours s'adresse aux dirigeants et aux salariés de la filière. Si vous savez joindre un fichier à un mail, vous pouvez suivre les modules."],
  ["Quel outil d'IA faut-il ?", "Celui que vous utilisez déjà, ou un outil grand public : ChatGPT, Claude, Le Chat de Mistral, Copilot ou Gemini. Le module 8 vous aide ensuite à choisir en connaissance de cause et à limiter votre dépendance."],
  ['Combien de temps cela prend-il ?', `Environ ${dureeTotale} au total, à répartir sur 4 à 6 semaines. Les modules durent de ${fmtDuree(dMin)} à ${fmtDuree(dMax)} et se suivent à votre rythme.`],
  ["Puis-je essayer avant de m'inscrire ?", 'Oui. Les modules 0 et 1 sont en accès libre. La création du compte est gratuite et débloque la suite, les quiz et le suivi de votre progression.'],
  ['Mes documents sont-ils protégés ?', "Vous travaillez sur des documents anonymisés : le module 0 explique comment faire, le module 7 vous apprend à décider de ce que vous pouvez confier à un outil. Les fichiers déposés sur la plateforme ne sont visibles que par vous et les évaluateurs."],
  ['Serai-je accompagné ?', "Oui. En plus des modules, vous réservez une séance individuelle en visio avec votre formateur, directement dans son agenda en ligne, au créneau qui vous convient. Nous conseillons de la placer après le module 5, quand votre projet est monté : on travaille alors sur votre cas et vos propres documents."],
  ['Que vaut le badge Niveau 1 ?', "Il atteste votre formation à la maîtrise de l'IA sur six compétences, évaluées à partir de votre projet final. Chaque badge a une page de vérification en ligne que vous pouvez partager."],
  ['Et après le Niveau 1 ?', "Votre projet final sert de point de départ au Niveau 2 : l'équipe PerfIA reprend vos cas réels en formation-action et les déploie sur une infrastructure que vous maîtrisez."],
];
---
<Base title="Parcours IA filière bois" description={`Dix modules en ligne pour prendre en main l'IA générative sur une tâche réelle de votre entreprise. Environ ${dureeTotale}, badge Niveau 1, Kosmio × Xylofutur.`}>
  <!-- ============ Héros ============ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__text">
        <div class="hero__logos">
          <img src="/marques/kosmio-blanc.svg" alt="Kosmio" />
          <span aria-hidden="true">×</span>
          <img src="/marques/xylofutur-blanc.png" alt="Xylofutur" />
        </div>
        <span class="eyebrow">Parcours IA filière bois · Niveau 1</span>
        <h1 id="hero-title">Prenez en main l'IA <em>sur un vrai dossier de votre entreprise.</em></h1>
        <p class="hero__lead">Dix modules courts en ligne, à votre rythme. Vous partez d'une tâche réelle, un devis, un DCE, des mails, et vous repartez avec un prototype testé, une charte d'usage et un badge Niveau 1.</p>
        <div class="hero__ctas">
          <a class="btn btn--primary btn--lg" href="/inscription/" data-auth="out">Créer mon compte →</a>
          <a class="btn btn--primary btn--lg" href="/parcours/" data-auth="in" hidden id="reprendre">Reprendre mon parcours →</a>
          <a class="btn btn--light btn--lg" href="/modules/m0/" data-auth="out">Voir le module 0</a>
          <a class="btn btn--light btn--lg" href="/parcours/" data-auth="in" hidden>Mon tableau de bord</a>
        </div>
        <p class="hero__sig"><b>{modules.length} modules</b> · environ {dureeTotale} sur 4 à 6 semaines · <b>une séance individuelle en visio</b> avec votre formateur</p>
      </div>

      <Rondelle modules={modules.map((m) => ({ id: m.id, ordre: m.ordre, titre: m.titre }))} />
    </div>
  </section>

  <!-- ============ Bandeau des cas ============ -->
  <div class="marquee" aria-label="Exemples de cas fil rouge">
    <div class="marquee__track">
      {[0, 1].map((k) => (
        <div class="marquee__set" aria-hidden={k === 1 ? 'true' : undefined}>
          {cas.map((c) => <span>{c}</span>)}
        </div>
      ))}
    </div>
  </div>

  <!-- ============ Vidéo ============ -->
  <section class="sec">
    <div class="container sec-video">
      <div class="sec-head sec-head--center reveal">
        <span class="eyebrow">Le parcours en deux minutes</span>
        <h2>Comprendre, essayer, <em>décider.</em></h2>
      </div>
      <figure class="video-frame reveal">
        <video src="/videos/m0-v1.mp4" controls preload="metadata" playsinline poster="/videos/m0-v1.jpg">
          <track kind="subtitles" srclang="fr" label="Français" src="/videos/m0-v1.vtt" />
        </video>
      </figure>
    </div>
  </section>

  <!-- ============ Principe ============ -->
  <section class="sec sec--sand">
    <div class="container">
      <div class="sec-head reveal">
        <span class="eyebrow">Le principe</span>
        <h2>Votre tâche réelle sert de fil rouge, <em>du premier au dernier module.</em></h2>
        <p class="t-lead">Au module 0, vous choisissez une tâche qui revient souvent dans votre entreprise. Chaque module la fait avancer d'un cran, jusqu'au dossier de décision qui compose votre projet final.</p>
      </div>
      <div class="facts">
        <article class="fact reveal">
          <div class="fact__num">1 cas</div>
          <p>Le vôtre, choisi parmi huit cas types de la filière ou proposé par vous, avec un vrai document anonymisé.</p>
        </article>
        <article class="fact reveal">
          <div class="fact__num">{dureeTotale}</div>
          <p>Sur 4 à 6 semaines, en modules de {fmtDuree(dMin)} à {fmtDuree(dMax)}, que vous suivez à votre rythme.</p>
        </article>
        <article class="fact reveal">
          <div class="fact__num">6</div>
          <p>Compétences évaluées sur votre projet final pour délivrer le badge Niveau 1, vérifiable en ligne.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ Séance individuelle ============ -->
  <section class="sec seance">
    <div class="container seance__grid">
      <div class="reveal">
        <span class="eyebrow">Inclus dans le parcours</span>
        <h2>Une séance individuelle, <em>sur votre cas.</em></h2>
        <p class="t-lead">À mi-parcours, vous réservez une séance en visio avec Mathieu Pesin, votre formateur PerfIA, au créneau qui vous arrange. On ouvre ensemble votre cas, vos premiers essais et ce qui coince, et on adapte la suite du parcours à votre entreprise.</p>
        <ul class="seance__points">
          <li><span><strong>Vous choisissez le moment</strong> dans l'agenda en ligne, sans échange de mails.</span></li>
          <li><span><strong>On travaille sur vos documents</strong>, avec votre outil d'IA et vos contraintes.</span></li>
          <li><span><strong>Vous repartez avec vos prochaines étapes</strong>, ajustées à votre cas.</span></li>
        </ul>
        <div class="hero__ctas">
          <a class="btn btn--primary btn--lg" href="/inscription/" data-auth="out">Créer mon compte →</a>
          <a class="btn btn--primary btn--lg" href={CAL} data-auth="in" hidden target="_blank" rel="noopener">Réserver ma séance ↗</a>
        </div>
      </div>
      <div class="agenda reveal" aria-hidden="true">
        <div class="agenda__head">
          <span class="agenda__avatar">MP</span>
          <div><strong>Séance individuelle PerfIA</strong><span>Visio · avec Mathieu Pesin</span></div>
        </div>
        <div class="agenda__days">
          {[['Lun', ['9:30', '14:00']], ['Mar', ['11:00']], ['Mer', ['9:00', '16:30']], ['Jeu', ['10:00', '15:00']], ['Ven', ['9:30']]].map(([j, h]) => (
            <div class="agenda__day">
              <span>{j}</span>
              {(h as string[]).map((x) => <i class={j === 'Jeu' && x === '10:00' ? 'is-on' : ''}>{x}</i>)}
            </div>
          ))}
        </div>
        <p class="agenda__note">Exemple de créneaux · vous choisissez le vôtre</p>
      </div>
    </div>
  </section>

  <!-- ============ Pour qui ============ -->
  <section class="sec">
    <div class="container pourqui">
      <div class="reveal">
        <span class="eyebrow">Pour qui ?</span>
        <h2>Conçu pour les entreprises <em>de la filière forêt-bois.</em></h2>
        <p class="t-lead">Dirigeants et salariés, sans prérequis technique. Il vous faut un ordinateur, un outil d'IA grand public et un document de votre quotidien.</p>
        <ul class="metiers">
          {metiers.map((m) => <li>{m}</li>)}
        </ul>
      </div>
      <figure class="pourqui__visual reveal">
        <img src="/marques/bois-ia.webp" alt="Grumes de bois empilées, sections claires et écorce sombre, traversées de fins traits lumineux." loading="lazy" width="800" height="1200" />
        <figcaption>Votre métier d'abord.<br />L'outil ensuite.</figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ Méthode ============ -->
  <section class="sec sec--sand">
    <div class="container">
      <div class="sec-head reveal">
        <span class="eyebrow">La méthode</span>
        <h2>Quatre étapes, <em>du premier essai à la décision.</em></h2>
      </div>
      <ol class="phases">
        {phases.map((p) => (
          <li class="phase reveal">
            <span class="phase__n">{p.n} · {p.mods}</span>
            <h3>{p.titre}</h3>
            <p>{p.txt}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ Programme ============ -->
  <section class="sec" id="programme">
    <div class="container programme">
      <div class="sec-head reveal">
        <span class="eyebrow">Programme</span>
        <h2>Dix modules, <em>de la première demande au prototype mesuré.</em></h2>
        <p class="t-lead">Chaque module associe des vidéos courtes, une fiche mémo, un exercice sur votre cas et, souvent, un quiz.</p>
      </div>
      <ol class="mods">
        {modules.map((m) => (
          <li class="reveal">
            <a class="mod" href={`/modules/${m.id}/`}>
              <span class="mod__num">M{m.ordre}</span>
              <span class="mod__body">
                <span class="mod__title">{m.titre}</span>
                <span class="mod__resume">{m.resume}</span>
              </span>
              <span class="mod__meta">
                {m.ordre <= 1 && <span class="pill pill--ok">Accès libre</span>}
                {m.competences.length > 0 && <span class="pill">{m.competences.join(' · ')}</span>}
                <span class="mod__duree">{fmtDuree(m.duree)}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
      <p class="programme__more"><a class="btn btn--secondary" href="/programme/">Voir le programme détaillé →</a></p>
    </div>
  </section>

  <!-- ============ Badge ============ -->
  <section class="sec sec--dark">
    <div class="container badge-sec">
      <div class="reveal">
        <span class="eyebrow">Le badge Niveau 1</span>
        <h2>Six compétences, <em>prouvées sur votre projet.</em></h2>
        <p class="t-lead">Votre projet final rassemble ce que vous avez produit sur votre cas. Il est évalué sur six compétences ; le badge atteste votre formation à la maîtrise de l'IA et se vérifie en ligne.</p>
        <div class="badge-sec__seal"><Seal /></div>
      </div>
      <dl class="comp">
        {competences.map(([c, t, p]) => (
          <div class="comp__row reveal">
            <dt><span>{c}</span>{t}</dt>
            <dd>{p}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="sec sec--sand" id="faq">
    <div class="container faq">
      <div class="sec-head reveal">
        <span class="eyebrow">Questions fréquentes</span>
        <h2>Vous vous demandez sûrement…</h2>
      </div>
      <div class="faq__list">
        {faq.map(([q, r]) => (
          <details>
            <summary>{q}</summary>
            <p>{r}{q.startsWith('Et après') && <> <a href="https://perfia.kosm.io/souverainete.html">En savoir plus sur le déploiement souverain</a>.</>}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ Appel final ============ -->
  <section class="sec final">
    <div class="container">
      <span class="eyebrow">Prêt à commencer ?</span>
      <h2>Commencez par <em>votre cas.</em></h2>
      <p class="t-lead">Créez votre compte, suivez le module 0 et choisissez la tâche que vous allez faire avancer. À mi-parcours, vous la reprenez avec votre formateur en séance individuelle.</p>
      <div class="hero__ctas">
        <a class="btn btn--primary btn--lg" href="/inscription/">Créer mon compte →</a>
        <a class="btn btn--light btn--lg" href="/programme/">Lire le programme</a>
      </div>
      <div class="contacts">
        <div class="contact">
          <img src="/marques/kosmio-blanc.svg" alt="Kosmio" height="26" />
          <p>Mathieu Pesin · Accompagnement IA filière bois</p>
          <p><a href="mailto:mathieu@kosm.io">mathieu@kosm.io</a></p>
        </div>
        <div class="contact">
          <img src="/marques/xylofutur-blanc.png" alt="Xylofutur" height="32" />
          <p>Pôle de compétitivité Forêt-Bois-Papier</p>
          <p><a href="https://www.xylofutur.fr/">xylofutur.fr →</a></p>
        </div>
      </div>
    </div>
  </section>

  <div class="sticky-cta" data-auth="out">
    <a class="btn btn--primary" href="/inscription/">Créer mon compte →</a>
  </div>
</Base>

<script>
  document.addEventListener('rondelle:progress', (e: any) => {
    const c = e.detail?.courant; const a = document.getElementById('reprendre') as HTMLAnchorElement | null;
    if (!a) return;
    if (c) { a.href = `/modules/${c.id}/`; a.textContent = `Reprendre : M${c.ordre} ${c.titre} →`; }
    else { a.href = '/projet-final/'; a.textContent = 'Déposer mon projet final →'; }
  });
  const sticky = document.querySelector<HTMLElement>('.sticky-cta');
  const hero = document.querySelector('.hero');
  if (sticky && hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => sticky.classList.toggle('visible', !e.isIntersecting), { threshold: 0 }).observe(hero);
  }
</script>

<style>
  /* ============ Héros ============ */
  .hero {
    position: relative; overflow: hidden; color: var(--white);
    background:
      radial-gradient(1200px 600px at 80% -10%, rgba(0,177,148,0.18), transparent 60%),
      radial-gradient(900px 500px at 0% 100%, rgba(186,135,72,0.18), transparent 60%),
      var(--ink-900);
    padding-block: clamp(3.5rem, 9vw, 8rem);
  }
  .hero__grid { display: grid; gap: var(--space-7); align-items: center; }
  @media (min-width: 1024px) { .hero__grid { grid-template-columns: 1.35fr 1fr; gap: var(--space-8); } }
  .hero__text { min-width: 0; }
  .hero__logos { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-5); }
  .hero__logos img { height: 26px; width: auto; display: block; opacity: .92; }
  .hero__logos img + span + img { height: 30px; }
  .hero__logos span { color: rgba(255,255,255,.35); font-size: .9rem; }
  .hero .eyebrow { color: var(--xf-green-500); }
  .hero h1 {
    color: var(--white); font-size: clamp(2.6rem, 6.4vw, 5.25rem); line-height: .98;
    letter-spacing: -0.03em; margin: var(--space-5) 0; text-wrap: balance;
  }
  .hero h1 em { font-style: italic; color: var(--xf-green-500); }
  .hero__lead { font-size: var(--text-lead); line-height: 1.55; color: rgba(255,255,255,.8); max-width: 40ch; margin: 0 0 var(--space-7); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--space-4); }
  .hero__sig { margin: var(--space-7) 0 0; font-family: var(--font-mono); font-size: .72rem; color: rgba(255,255,255,.58); letter-spacing: var(--tracking-mono); text-transform: uppercase; line-height: 1.8; }
  .hero__sig b { color: var(--xf-gold-500); }

  :global(.btn--light) { background: transparent; color: var(--white); border: 1.5px solid rgba(255,255,255,.85); }
  :global(.btn--light:hover) { background: var(--white); color: var(--ink-900); }



  /* ============ Bandeau ============ */
  .marquee { background: var(--xf-green-500); color: var(--white); padding-block: var(--space-4); overflow: hidden; }
  .marquee__track { display: flex; width: max-content; }
  .marquee__set { display: flex; flex: none; gap: var(--space-7); padding-right: var(--space-7); font-family: var(--font-mono); font-weight: 700; text-transform: uppercase; letter-spacing: var(--tracking-mono); font-size: .78rem; white-space: nowrap; }
  .marquee__set span { display: inline-flex; align-items: center; gap: var(--space-3); }
  .marquee__set span::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: rgba(255,255,255,.7); }
  @media (prefers-reduced-motion: no-preference) {
    .marquee__track { animation: defile 45s linear infinite; }
    .marquee:hover .marquee__track { animation-play-state: paused; }
  }
  @keyframes defile { to { transform: translateX(-50%); } }

  /* ============ Sections ============ */
  .sec { padding-block: clamp(4rem, 8vw, 7.5rem); }
  .sec--sand { background: var(--xf-sand-100); }
  .sec--dark { background: var(--ink-900); color: var(--white); }
  .sec-head { max-width: 52rem; margin-bottom: var(--space-8); }
  .sec-head--center { text-align: center; margin-inline: auto; margin-bottom: var(--space-7); }
  .sec h2 { font-size: var(--text-h1); margin: var(--space-4) 0 var(--space-5); text-wrap: balance; }
  .sec h2 em { font-style: italic; color: var(--xf-green-600); }
  .sec-head .t-lead { max-width: 60ch; margin: 0; }

  .video-frame { margin: 0 auto; max-width: 920px; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg); background: var(--ink-900); aspect-ratio: 16 / 9; }
  .video-frame video { width: 100%; height: 100%; display: block; }

  .facts { display: grid; gap: var(--space-5); }
  @media (min-width: 768px) { .facts { grid-template-columns: repeat(3, 1fr); } }
  .fact { position: relative; overflow: hidden; background: var(--white); border: 1px solid var(--grey-300); border-radius: var(--radius-lg); padding: var(--space-7) var(--space-6); transition: transform .3s var(--ease-out), box-shadow .3s var(--ease-out); }
  .fact:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .fact::after { content: ""; position: absolute; right: -34px; bottom: -34px; width: 120px; height: 120px; border-radius: 50%; border: 10px solid var(--xf-green-50); box-shadow: 0 0 0 10px var(--white), 0 0 0 20px var(--xf-green-50); }
  .fact__num { position: relative; z-index: 1; font-family: var(--font-display); font-weight: 700; color: var(--xf-green-600); font-size: clamp(2.75rem, 5vw, 4rem); line-height: 1; letter-spacing: -0.03em; }
  .fact p { position: relative; z-index: 1; color: var(--ink-700); margin: var(--space-4) 0 0; max-width: 32ch; }


  .seance { background: var(--xf-green-50); }
  .seance__grid { display: grid; gap: var(--space-8); align-items: center; }
  @media (min-width: 960px) { .seance__grid { grid-template-columns: 1.15fr .85fr; } }
  .seance__grid > * { min-width: 0; }
  .seance .t-lead { color: var(--ink-700); max-width: 56ch; }
  .seance__points { list-style: none; padding: 0; margin: var(--space-6) 0 var(--space-7); display: grid; gap: var(--space-3); }
  .seance__points li { display: flex; gap: var(--space-3); align-items: baseline; color: var(--ink-700); }
  .seance__points li::before { content: "→"; color: var(--xf-green-600); font-weight: 700; flex: none; }
  .seance__points strong { color: var(--ink-900); font-weight: var(--fw-semibold); }
  .agenda { background: var(--white); border: 1px solid rgba(0,153,130,.25); border-radius: var(--radius-lg); padding: var(--space-6); box-shadow: var(--shadow-lg); max-width: 440px; justify-self: center; width: 100%; transform: rotate(1.2deg); }

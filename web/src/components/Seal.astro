---
// Sceau des badges PerfIA, SVG fait main, palette PerfIA. Même dessin que l'image Open Badges servie par l'API.
interface Props { label?: string }
const { label = 'NIVEAU 1' } = Astro.props;
---
<svg class="badge-seal" viewBox="0 0 120 120" role="img" aria-label={`Sceau du badge PerfIA ${label}`}>
  <circle cx="60" cy="60" r="56" fill="#E6F7F4" stroke="#00B194" stroke-width="4" />
  <circle cx="60" cy="60" r="44" fill="#fff" stroke="#BA8748" stroke-width="2" stroke-dasharray="3 4" />
  <path d="M60 30c-9 11-14 20-14 28a14 14 0 0 0 28 0c0-8-5-17-14-28z" fill="#00B194" />
  <path d="M60 46v32M60 60l-6-6M60 68l7-7" stroke="#fff" stroke-width="2.5" stroke-linecap="round" fill="none" />
  <text x="60" y="98" text-anchor="middle" font-family="Helvetica Neue, Arial, sans-serif" font-size={label.length > 8 ? 9.5 : 11} font-weight="700" fill="#1F2D3D">{label}</text>
</svg>

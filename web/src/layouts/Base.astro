---
import '../styles/tokens.css';
import '../styles/app.css';

interface Props { title: string; description?: string; current?: string }
const { title, description = "Parcours IA filière bois : prendre en main l'IA générative dans votre entreprise, badge Niveau 1.", current = '' } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Académie PerfIA</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1F2D3D" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@600;700&display=swap" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Aller au contenu</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href="/" aria-label="Académie PerfIA, accueil">
          <img src="/marques/perfia-encre.svg" alt="" class="brand__logo" width="44" height="22" />
          <span class="brand__name">Perf<strong>IA</strong> <span>Académie</span></span>
        </a>
        <nav class="nav" id="nav" aria-label="Navigation principale">
          <a href="/programme/" aria-current={current === 'programme' ? 'page' : undefined}>Programme</a>
          <a href="/parcours/" data-auth="in" hidden aria-current={current === 'parcours' ? 'page' : undefined}>Mon parcours</a>
          <a href="/projet-final/" data-auth="in" hidden aria-current={current === 'projet' ? 'page' : undefined}>Projet final</a>
          <a href="/evaluation/" data-auth="eval" hidden aria-current={current === 'evaluation' ? 'page' : undefined}>Évaluation</a>
          <a href="https://perfia.kosm.io/">Site PerfIA</a>
          <a href="/connexion/" data-auth="out">Connexion</a>
          <a href="#" data-auth="in" data-logout hidden>Déconnexion</a>
        </nav>
        <a href="/inscription/" data-auth="out" class="btn btn--primary btn--sm site-header__cta">S'inscrire →</a>
        <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav" aria-label="Ouvrir le menu">
          <svg class="nav-toggle__open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
          <svg class="nav-toggle__close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="5" x2="19" y2="19" /><line x1="19" y1="5" x2="5" y2="19" /></svg>
        </button>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="site-footer__brands">
          <img src="/marques/kosmio-blanc.svg" alt="Kosmio" height="24" />
          <span aria-hidden="true">×</span>
          <img src="/marques/xylofutur-blanc.png" alt="Xylofutur" height="28" />
        </div>
        <div class="site-footer__row">
          <span>© {new Date().getFullYear()} Kosmio × Xylofutur · Académie PerfIA, Parcours IA filière bois</span>
          <span><a href="/programme/">Programme</a> · <a href="/mentions-legales/">Mentions légales</a> · <a href="/confidentialite/">Données personnelles</a> · <a href="https://perfia.kosm.io/">Site PerfIA</a></span>
        </div>
      </div>
    </footer>
    <script>
      import { pb, isEvaluateur } from '../lib/pb.js';
      const logged = pb.authStore.isValid;
      document.querySelectorAll<HTMLElement>('[data-auth="in"]').forEach((el) => (el.hidden = !logged));
      document.querySelectorAll<HTMLElement>('[data-auth="out"]').forEach((el) => (el.hidden = logged));
      document.querySelectorAll<HTMLElement>('[data-auth="eval"]').forEach((el) => (el.hidden = !(logged && isEvaluateur())));
      document.querySelector('[data-logout]')?.addEventListener('click', (e) => {
        e.preventDefault();
        pb.authStore.clear();
        window.location.href = '/';
      });
      if (logged) pb.collection('users').authRefresh().catch(() => pb.authStore.clear());

      // Menu mobile
      const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const nav = document.getElementById('nav');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
        nav?.classList.toggle('nav--open', open);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav?.classList.contains('nav--open')) toggle?.click();
      });

      // Apparition au défilement (le contenu reste visible sans JavaScript)
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver((entries) => entries.forEach((en) => {
          if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
        }), { rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('in'));
    </script>
  </body>
</html>
